# RealityChecker Configuration
# Copy this file to .env and fill in your values

# GitHub Personal Access Token (optional - for version checks)
GH_TOKEN=

# OpenMetadata Integration (optional - skip if not using OM)
OPENMETADATA_HOST=http://localhost:8585/api
OPENMETADATA_TOKEN=

# YouTube Data API v3 Key (optional - yt-dlp fallback works without it)
# See README for setup instructions
YOUTUBE_API_KEY=

# Groq API Key (optional - heuristic fallback works without it)
# Get one at https://console.groq.com/
GROQ_API_KEY=

# Cache TTL in seconds (default: 43200 = 12 hours)
CACHE_TTL_SECONDS=43200

# Request timeout in seconds (default: 15)
REQUEST_TIMEOUT_SECONDS=15

# Max comments to sample per video (default: 100)
COMMENT_SAMPLE_SIZE=100

# Use yt-dlp as comments fallback when YouTube API comments call fails.
# Keep false for faster responses when API key restrictions/quota errors occur.
ENABLE_YTDLP_COMMENT_FALLBACK=false
